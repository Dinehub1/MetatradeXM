# ── OpenRouter API (primary — cloud AI) ────────────────────────────────────────
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=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

# ── Model Tiers (cheap first → expensive only if needed) ───────────────────────
# TIER 1 — Fast & Cheap (primary for most signals)
# Models: google/gemini-2.5-flash (~0.10$/M tokens, 128k context, ultra-fast)
OPENROUTER_MODEL=google/gemini-2.5-flash

# TIER 2 — Fast reasoning (used only when Tier 1 fails/times out)
# x-ai/grok-4.1-fast is a PREMIUM model (~10x the cost of flash)
# Only use it as explicit fallback, NOT as primary
OPENROUTER_FAST_MODEL=x-ai/grok-4.1-fast

# TIER 3 — Full reasoning (only for low-confidence signals needing deep analysis)
# openrouter/auto routes to cheapest capable model; expensive only when truly needed
OPENROUTER_REASONING_MODEL=deepseek/deepseek-chat-v3-0324

# ── Ollama (offline fallback — free, no API cost) ───────────────────────────────
OLLAMA_MODEL=qwen2.5:7b

# ── Timeouts (seconds) ─────────────────────────────────────────────────────────
# Tier 1: fast model = 10s timeout (plenty for flash)
OPENROUTER_TIER1_TIMEOUT=10
# Tier 2: reasoning model = 15s timeout
OPENROUTER_TIER2_TIMEOUT=15
# Ollama: CPU-bound, needs more time = 45s timeout
OLLAMA_TIMEOUT=45

# ── Analysis Intervals ─────────────────────────────────────────────────────────
# Full AI analysis every N seconds (was 45s, now smarter)
ANALYSIS_INTERVAL_S=60

# ── Feature Flags ─────────────────────────────────────────────────────────────
# Set to 1 to enable verbose AI cost logging
LOG_AI_COSTS=0
