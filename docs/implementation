#### [NEW] bridges/ws_bridge.py (on Ubuntu)

```python
class WSBridge:
    """
    WebSocket client → Windows VM for real-time data.
    HTTP webhook → Windows VM for trade execution.
    Same public API as WebhookBridge (drop-in replacement).
    """
    def __init__(self, ws_url, http_url):
        self.ws_url = ws_url        # ws://<WIN_IP>:5002
        self._webhook = WebhookBridge(http_url)  # http://<WIN_IP>:5001
        self._latest_ticks = {}     # symbol → {bid, ask, time}
        self._buffers = {}          # symbol → tf → DataFrame
        self.connected = False

    # Data reads → from WebSocket cache (sub-second latency)
    def get_tick(self, symbol): ...
    def get_candles(self, symbol, tf, count): ...
    def get_indicators(self, symbol, timeframes): ...

    # Trade execution → delegate to HTTP webhook (same as before)
    def place_order(self, params): return self._webhook.place_order(params)
    def close_position(self, ticket): return self._webhook.close_position(ticket)
    def modify_position(self, t, sl, tp): return self._webhook.modify_position(t, sl, tp)
    def get_open_positions(self, sym=None): return self._webhook.get_open_positions(sym)
    def get_account_info(self): return self._webhook.get_account_info()
```

