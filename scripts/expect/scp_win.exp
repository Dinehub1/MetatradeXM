#!/usr/bin/expect -f
set timeout 120
set local_file [lindex $argv 0]
set remote_path [lindex $argv 1]
spawn scp -o StrictHostKeyChecking=no $local_file Administrator@206.72.198.54:$remote_path
expect {
    "password:" {
        send "q3XtM9f%\r"
        exp_continue
    }
    eof {
        exit 0
    }
    timeout {
        puts "\nTIMEOUT"
        exit 1
    }
}
