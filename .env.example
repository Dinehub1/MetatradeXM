# MetatradeXM Configuration

# ─── Supabase Configuration (Cloud Database) ─────────────────────────────
# Get these from your Supabase project settings:
# 1. Go to https://supabase.com
# 2. Create a new project
# 3. Copy your Project URL and Anon Key from Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_PROJECT_REF=your-project-ref

# MT5 webhook / stream source. The bot ingests from here and writes the
# dashboard-ready shape into Supabase; the dashboard reads Supabase only.
# HTTP endpoints for trade/history/candles. If your Windows webhook exposes
# HTTP on 5002, set this to http://host:5002.
WIN_WEBHOOK_URL=http://206.72.198.54:5001
WIN_WS_URL=ws://206.72.198.54:5002
WEBHOOK_AUTH_TOKEN=super_secret_token_2026

# ─── NVIDIA AI Configuration ─────────────────────────────────────────────
NVIDIA_API_KEY=nvapi-your_primary_key_here
NVIDIA_API_KEY_2=
INVOKE_URL=https://integrate.api.nvidia.com/v1/chat/completions
MODEL_NAME=meta/llama-3.3-70b-instruct
MAX_TOKENS=16384
TEMPERATURE=1.0
TOP_P=1.0
STREAM=true
THINKING=true

# ─── Trading Configuration ──────────────────────────────────────────────
DRY_RUN=false  # Set to true for paper trading
LOG_LEVEL=INFO
